# Clerk Authentication
# Hämta din nyckel från https://dashboard.clerk.com -> API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# Supabase (server-only, used by api/quote-request.ts)
# Find these in Supabase dashboard -> Project Settings -> API.
# Never prefix them with VITE_: that would ship them to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
