# Clerk Authentication
# Hämta din nyckel från https://dashboard.clerk.com -> API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# Supabase (used by api/quote-request.ts)
# Find these in Supabase dashboard -> Project Settings -> API Keys.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
# Secret key (sb_secret_...) or legacy service_role key. Server-only:
# NEVER prefix it with VITE_, that would ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxx

# Resend (emails for quote requests, used by api/_lib/sendQuoteEmails.ts). Server-only.
RESEND_API_KEY=re_xxxxxxxxxxxx
QUOTE_EMAIL_FROM="Nordic Group <quotes@info.nordicgr.com>"
# Optional: where new requests are sent (default info@nordicgr.com)
QUOTE_TEAM_EMAIL=info@nordicgr.com
